@EcommerceApi_HostAddress = http://localhost:5094

### Obtener todos los productos
GET {{EcommerceApi_HostAddress}}/Producto/GetProductos
Accept: application/json

### Crear producto
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "Laptop Lenovo",
  "descripcion": "Laptop para trabajo y estudio",
  "precio": 2500000,
  "stock": 10
}

### Crear producto con imagen (se sube a Cloudinary y se guarda la URL)
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "Laptop Lenovo",
  "descripcion": "Laptop para trabajo y estudio",
  "precio": 2500000,
  "stock": 10,
  "imagenBase64": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAgAAAAICAIAAABLbSncAAAAEklEQVR4nGP4z8CAFWEXHbQSACj/P8Fu7N9hAAAAAElFTkSuQmCC"
}

### Validacion: Base64 invalido (debe responder 400)
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "Mouse",
  "precio": 50000,
  "stock": 1,
  "imagenBase64": "esto-no-es-base64"
}

### Actualizar producto
PUT {{EcommerceApi_HostAddress}}/Producto/UpdateProducto/1
Content-Type: application/json

{
  "nombre": "Laptop Lenovo ThinkPad",
  "descripcion": "Laptop para trabajo y estudio",
  "precio": 2750000,
  "stock": 8
}

### Eliminar producto
DELETE {{EcommerceApi_HostAddress}}/Producto/DeleteProducto/1

### Validacion: nombre vacio (debe responder 400)
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "",
  "descripcion": "Sin nombre",
  "precio": 1000,
  "stock": 1
}

### Validacion: precio negativo (debe responder 400)
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "Mouse",
  "descripcion": "Precio invalido",
  "precio": -500,
  "stock": 1
}

### Validacion: stock negativo (debe responder 400)
POST {{EcommerceApi_HostAddress}}/Producto/CreateProducto
Content-Type: application/json

{
  "nombre": "Teclado",
  "descripcion": "Stock invalido",
  "precio": 80000,
  "stock": -3
}

### Producto inexistente (debe responder 404)
PUT {{EcommerceApi_HostAddress}}/Producto/UpdateProducto/99999
Content-Type: application/json

{
  "nombre": "No existe",
  "descripcion": "Prueba 404",
  "precio": 1000,
  "stock": 1
}

### ---------- Usuarios y JWT ----------

### Registrar usuario
POST {{EcommerceApi_HostAddress}}/api/Auth/Register
Content-Type: application/json

{
  "nombre": "Luis",
  "email": "luis@correo.com",
  "password": "Clave123"
}

### Login (la respuesta es el token: copialo en @token)
POST {{EcommerceApi_HostAddress}}/api/Auth/Login
Content-Type: application/json

{
  "email": "luis@correo.com",
  "password": "Clave123"
}

### Crear producto con token (sin token responde 401)
@token = PEGAR_AQUI_EL_TOKEN
POST {{EcommerceApi_HostAddress}}/api/producto
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nombre": "Mouse",
  "precio": 50000,
  "stock": 3
}
